{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "trustx-frontend": {
            "root": "client",
            "framework": "vite",
            "buildCommand": "npm install && npm run build"
        },
        "trustx-backend": {
            "root": "server",
            "framework": "express",
            "buildCommand": "npm install"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "trustx-backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "trustx-frontend"
            }
        }
    ]
}